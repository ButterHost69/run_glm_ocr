# Paths
# By default everything is relative to the directory from which setup.sh is called.
# Override these in config/local.env or through the environment if needed.
CALLER_ROOT="${CALLER_ROOT:-$(pwd)}"
WORK_ROOT="${WORK_ROOT:-${ROOT_DIR}}"
PADDLEX_ROOT="${PADDLEX_ROOT:-${WORK_ROOT}/PaddleX}"
VENV="${VENV:-${WORK_ROOT}/.venv}"

# Source/version configuration
PADDLEX_BRANCH="${PADDLEX_BRANCH:-release/3.7}"
PADDLE_VERSION="${PADDLE_VERSION:-3.0.0}"
GLMOCR_VERSION="${GLMOCR_VERSION:-0.1.5}"
VLLM_VERSION="${VLLM_VERSION:-0.19.0}"
TRANSFORMERS_VERSION="${TRANSFORMERS_VERSION:-5.3.1}"

# Runtime configuration
LAYOUT_MODEL_DIR="${LAYOUT_MODEL_DIR:-${WORK_ROOT}/output/ppdoclayoutv3_test/best_model/inference}"
VLLM_PORT="${VLLM_PORT:-8081}"
VLLM_MODEL_NAME="${VLLM_MODEL_NAME:-glm-ocr}"
VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.90}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-8192}"
